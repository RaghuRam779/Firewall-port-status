# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://mongo:27017/firewall-checker

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Scanning
# Comma-separated list of hosts/CIDRs this instance is allowed to scan.
# Leave empty to allow any target the authenticated user attests they are authorized to test
# (authorization is still enforced via the required confirmation flag on every scan request).
SCAN_TARGET_ALLOWLIST=
MAX_SCAN_DURATION_MS=180000
NMAP_PATH=nmap

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SCAN_RATE_LIMIT_MAX=10
